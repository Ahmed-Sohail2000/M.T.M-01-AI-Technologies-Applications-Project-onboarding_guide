# Copy to rag_backend/.env for local dev. db.py / config.py read these directly;
# the run-app skill also exports DATABASE_URL before starting uvicorn.

# --- Database ---
# SQLite is enough for local dev (no schema uses Postgres-only types).
# Point at docker-compose's postgres (port 5433 on host) if you need Postgres:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE_URL=sqlite:///./vaultmind.db

# --- LLM provider (priority: NVIDIA NIM > LM Studio) ---
# Leave NVIDIA_API_KEY blank to fall back to a local LM Studio server.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2

LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=google/gemma-4-E4B-it

# Note: CORS origins are hardcoded in app/main.py (localhost:3000/3001), not
# read from Settings.CORS_ORIGINS — deliberately omitted here since exporting
# a JSON-list env var via `source .env` in bash mangles the brackets/quotes.
